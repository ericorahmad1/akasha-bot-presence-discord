# ---- Discord ----
DISCORD_TOKEN=paste-presence-bot-token-here
DISCORD_APP_ID=000000000000000000
GUILD_ID=000000000000000000

# Category "Akasha Status Availability"
# #team-status = board + clock in/out posts
CH_STATUS=000000000000000000
# #team-status-manage = sick/leave cards, approvals, corrections
CH_MANAGE=000000000000000000
# #team-status-log = audit trail, missing list, recaps
CH_LOG=000000000000000000

# Presence Employee = interns + core team
ROLE_EMPLOYEE=000000000000000000
# Presence Management = Yuni, Ayu, Chris
ROLE_MANAGEMENT=000000000000000000
# Presence Admin = Chris
ROLE_ADMIN=000000000000000000

# ---- Clockify (read-only use; a workspace admin key is needed to see everyone's running timer) ----
CLOCKIFY_API_KEY=
CLOCKIFY_WORKSPACE_ID=

# ---- Behaviour ----
# Kill switch: false = commands answer "paused" and no jobs run
PRESENCE_ENABLED=false
# true = posts get a [TEST] prefix and DMs are written to #team-status-log instead
DRY_RUN=true
# A = needs approval, B = self-declared + management notified
POLICY_SICK=B
POLICY_LEAVE=A
# /claim while offline -> automatic clock-in (flagged)
AUTO_CLOCKIN_ON_CLAIM=true
MEETING_DEFAULT_MIN=30
LATE_GRACE_MIN=15
MENTION_AUTOREPLY=true
MENTION_COOLDOWN_MIN=60
# 0 = keep the auto-reply message
MENTION_DELETE_AFTER_MIN=10
# Only set true if mention auto-reply never sees mentions (needs the intent enabled in the Developer Portal)
MESSAGE_CONTENT_INTENT=false
CLAIM_POLL_SEC=60

# ---- Storage ----
DB_PATH=./data/presence.db
BACKUP_DIR=./data/backups
